<Application x:Class="Thoughtbench.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#111318" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171A21" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2B313D" />
        <SolidColorBrush x:Key="TextBrush" Color="#D4D4D4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF" />
    </Application.Resources>
</Application>
