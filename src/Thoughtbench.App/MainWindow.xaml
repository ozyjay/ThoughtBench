<Window x:Class="Thoughtbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thoughtbench"
        Height="820"
        Width="1220"
        MinHeight="680"
        MinWidth="980"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top"
                Padding="10"
                Margin="0,0,0,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Thoughtbench"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,16,0" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Starting..." />
                </StackPanel>
                <TextBlock x:Name="TokenStatsText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Tokens: loading" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <GroupBox Header="Model">
                    <StackPanel>
                        <TextBlock Text="ONNX GenAI model folder" Margin="0,0,0,4" />
                        <TextBox x:Name="ModelPathBox" MinHeight="54" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Browse" Click="BrowseModel_Click" />
                            <Button Content="Load" Click="LoadModel_Click" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Profiles">
                    <StackPanel>
                        <TextBox x:Name="ProfilePathBox" MinHeight="54" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open" Click="OpenProfile_Click" />
                            <Button Content="New" Click="NewProfile_Click" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Generation">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="Max tokens" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaxTokensBox" Text="1024" />
                        <TextBlock Grid.Row="1" Text="Temp" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TemperatureBox" Text="1.0" />
                        <TextBlock Grid.Row="2" Text="Top P" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TopPBox" Text="0.95" />
                        <TextBlock Grid.Row="3" Text="Top K" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TopKBox" Text="64" />
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="ThinkingBox" Content="Thinking mode" Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Knowledge">
                    <StackPanel>
                        <TextBlock x:Name="KnowledgeStatusText" Text="Knowledge: not indexed" />
                        <Button Content="Rebuild Index" Margin="0,8,8,0" Click="RebuildKnowledge_Click" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="ChatBox"
                         Grid.Row="0"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}" />

                <TextBox x:Name="InputBox"
                         Grid.Row="1"
                         Margin="0,10,0,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="SendButton" Content="Send" Width="92" Click="Send_Click" />
                    <Button Content="Stop" Width="92" Click="Stop_Click" />
                    <Button Content="Clear Conversation" Click="ClearConversation_Click" />
                    <Button Content="Rewrite Behaviour" Click="RewriteBehaviour_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="Behaviour">
                    <TextBox x:Name="BehaviourBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}" />
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Thinking">
                    <TextBox x:Name="ThinkingOutputBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}" />
                </GroupBox>
                <GroupBox Grid.Row="2" Header="Diagnostics">
                    <TextBox x:Name="DiagnosticsBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}" />
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
